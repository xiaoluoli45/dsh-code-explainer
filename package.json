{
  "name": "dsh-code-explainer",
  "version": "0.4.5",
  "description": "把 agent 实际执行的代码逐行翻译成非程序员也能看懂的中文：行尾注释同时说清「这行做什么」和「为什么这么写」，规则即时给出，规则判不出的行再用当前会话模型补充，并可一键关闭。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "rules.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "explain",
    "tool-call",
    "accessibility"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "license": "MIT"
}
