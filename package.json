{
  "name": "dsh-code-explainer",
  "version": "0.1.0",
  "description": "把 agent 实际执行的代码、命令和文件修改翻译成非程序员也能看懂的中文解释：每条工具调用下方一张默认收起的说明卡，规则解释即时出现，首次展开时可按需调用当前会话模型补充。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "rules.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "explain",
    "tool-call",
    "accessibility"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "license": "MIT"
}
